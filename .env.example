# Copy to .env and fill in values from YOUR Scalekit dashboard.
# Never commit .env.

# Dashboard → API credentials → Environment URL
SCALEKIT_ENVIRONMENT_URL=https://your-env.scalekit.cloud

# Dashboard → MCP servers → this server → Resource ID
SCALEKIT_RESOURCE_ID=res_xxxxxxxx

# Must match the Server URL you saved on that MCP server. No trailing slash.
MCP_URL=http://localhost:3000/mcp

# PORT=3000
# MCP_USE_OAUTH_DEBUG=1
